{
  "name": "autodev-studio",
  "version": "1.0.0",
  "description": "Zero-human software development company powered by AI agents",
  "private": true,
  "scripts": {
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern='src/middleware/.*/.*\\.test\\.js'",
    "test:integration": "jest --testPathPattern='tests/integration/.*\\.test\\.js'",
    "test:load": "jest --testPathPattern='tests/load/.*\\.test\\.js'",
    "lint": "eslint src/",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2"
  },
  "workspaces": [
    "src/middleware/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
